# Copy these into Netlify: Site configuration > Environment variables.
# Never commit real values to GitHub.

# Claude Console > API keys (platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe Dashboard > Developers > API keys. Start with the test key (sk_test_...).
STRIPE_SECRET_KEY=sk_test_...

# Any long random string. It stops strangers triggering plan generation directly.
# e.g. generate one at https://www.random.org/strings/ (32+ characters)
INTERNAL_SECRET=change-me-to-a-long-random-string
